@model CourseForm
@{
    ViewData["Title"] = "Изменение курса";
}
<h1>Изменение курса</h1>
<p>ID курса: @Model.CourseId</p>
<form asp-action="Edit" asp-route-id="@Model.CourseId" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_CourseFields" model="Model" />
    <div class="actions">
        <button type="submit">Сохранить изменения</button>
        <a class="button" asp-action="Details" asp-route-id="@Model.CourseId">Отмена</a>
    </div>
</form>
