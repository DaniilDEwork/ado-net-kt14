@model TeacherForm
@{
    ViewData["Title"] = "Добавление преподавателя";
}
<h1>Добавление преподавателя</h1>
<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_TeacherFields" model="Model" />
    <div class="actions">
        <button type="submit">Добавить преподавателя</button>
        <a class="button" asp-action="Index">Отмена</a>
    </div>
</form>
