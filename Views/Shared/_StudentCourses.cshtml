@model Student
<h2>Курсы студента</h2>
@if (Model.Courses.Count == 0)
{
    <p>Студент пока не записан на курсы</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID курса</th><th>Название</th><th>Преподаватель</th><th>Действие</th></tr></thead>
            <tbody>
            @foreach (var course in Model.Courses.OrderBy(course => course.CourseId))
            {
                <tr>
                    <td>@course.CourseId</td><td>@course.Title</td><td>@course.Teacher.Name</td>
                    <td><a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId">Просмотр</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
