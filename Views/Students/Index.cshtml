@model List<Student>
@{
    ViewData["Title"] = "Студенты";
}
<h1>Студенты</h1>
<a class="button" asp-action="Create">Добавить студента</a>
@if (Model.Count == 0)
{
    <p>Список пуст</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Имя</th><th>Количество курсов</th><th>Действия</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentId</td><td>@item.Name</td><td>@item.Courses.Count</td>
                    <td><div class="table-actions">
                        <a asp-action="Details" asp-route-id="@item.StudentId">Просмотр</a>
                        <a asp-action="Edit" asp-route-id="@item.StudentId">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@item.StudentId">Удалить</a>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
