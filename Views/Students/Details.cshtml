@model Student
@{
    ViewData["Title"] = "Студент";
}
<h1>Студент</h1>
<dl class="details">
    <dt>ID</dt><dd>@Model.StudentId</dd>
    <dt>Имя</dt><dd>@Model.Name</dd>
    <dt>Количество курсов</dt><dd>@Model.Courses.Count</dd>
</dl>
<partial name="_StudentCourses" model="Model" />
<div class="actions">
    <a class="button" asp-controller="Courses" asp-action="Index">Все курсы</a>
    <a class="button" asp-action="Edit" asp-route-id="@Model.StudentId">Изменить студента</a>
    <a class="button danger" asp-action="Delete" asp-route-id="@Model.StudentId">Удалить</a>
    <a class="button" asp-action="Index">К списку</a>
</div>
