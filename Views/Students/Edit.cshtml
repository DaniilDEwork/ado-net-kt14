@model StudentForm
@{
    ViewData["Title"] = "Изменение студента";
}
<h1>Изменение студента</h1>
<form asp-action="Edit" asp-route-id="@Model.StudentId" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_StudentFields" model="Model" />
    <div class="actions">
        <button type="submit">Сохранить изменения</button>
        <a class="button" asp-action="Details" asp-route-id="@Model.StudentId">Отмена</a>
    </div>
</form>
